<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0B0F19">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ULTRON AI"
        android:textColor="#00FFCC"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ultron Status: STANDBY"
        android:textColor="#E0E8F5"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/toggle_button"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:text="Activate Ultron"
        android:textColor="#0B0F19"
        android:backgroundTint="#00FFCC"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Say 'Ultron' to issue voice commands"
        android:textColor="#556B88"
        android:textSize="12sp"
        android:layout_marginTop="24dp" />

</LinearLayout>